<?xml version="1.0"?>
<!--
  Square: dive, then four 2 m sides, turning left 90 degrees at each corner.
  Ends back at the start, facing the start heading.
  Same safety pattern as playground.xml.
-->
<root BTCPP_format="4" main_tree_to_execute="Square">
  <BehaviorTree ID="Square">
    <Fallback name="Mission, else surface">
      <Sequence name="Mission">
        <WaitForOdometry timeout_sec="30"/>
        <RecordStart/>
        <ReactiveSequence name="Safety">
          <OdometryFresh max_age_sec="0.5"/>
          <IsArmed/>
          <Sequence name="Moves">
            <Timeout msec="60000"><GoToDepth name="Dive 0.5 m" depth_m="0.5"/></Timeout>
            <Hold seconds="2"/>
            <Timeout msec="60000"><Forward name="Side 1" distance_m="2.0" heading_deg="0"/></Timeout>
            <Timeout msec="60000"><Turn name="Corner 1" heading_deg="90"/></Timeout>
            <Timeout msec="60000"><Forward name="Side 2" distance_m="2.0" heading_deg="90"/></Timeout>
            <Timeout msec="60000"><Turn name="Corner 2" heading_deg="180"/></Timeout>
            <Timeout msec="60000"><Forward name="Side 3" distance_m="2.0" heading_deg="180"/></Timeout>
            <Timeout msec="60000"><Turn name="Corner 3" heading_deg="270"/></Timeout>
            <Timeout msec="60000"><Forward name="Side 4" distance_m="2.0" heading_deg="270"/></Timeout>
            <Timeout msec="60000"><Turn name="Face start" heading_deg="0"/></Timeout>
            <Hold seconds="2"/>
          </Sequence>
        </ReactiveSequence>
      </Sequence>
      <Sequence name="Surface, then report failure">
        <Surface seconds="10"/>
        <AlwaysFailure/>
      </Sequence>
    </Fallback>
  </BehaviorTree>
  <!-- Node list for Groot2 (same as tardigrade_nodes.xml). -->
  <TreeNodesModel>
    <Action ID="WaitForOdometry">
      <input_port name="timeout_sec" default="30">Fail if no odometry arrives within this many seconds</input_port>
      <input_port name="max_age_sec" default="0.5">Odometry older than this counts as missing</input_port>
    </Action>
    <Action ID="RecordStart">
    </Action>
    <Condition ID="OdometryFresh">
      <input_port name="max_age_sec" default="0.5">Odometry older than this counts as stale</input_port>
    </Condition>
    <Condition ID="IsArmed">
    </Condition>
    <Action ID="GoToDepth">
      <input_port name="depth_m">Metres below the start depth</input_port>
      <input_port name="tolerance_m" default="0.05">Close enough, in metres</input_port>
      <input_port name="max_speed" default="0.2">Vertical speed limit, m/s</input_port>
      <input_port name="heading_deg" default="0">Heading to hold, degrees left of the start heading</input_port>
    </Action>
    <Action ID="Forward">
      <input_port name="distance_m">Metres to travel</input_port>
      <input_port name="speed" default="0.2">m/s</input_port>
      <input_port name="heading_deg" default="0">Heading to hold, degrees left of the start heading</input_port>
    </Action>
    <Action ID="Backward">
      <input_port name="distance_m">Metres to travel</input_port>
      <input_port name="speed" default="0.2">m/s</input_port>
      <input_port name="heading_deg" default="0">Heading to hold, degrees left of the start heading</input_port>
    </Action>
    <Action ID="StrafeLeft">
      <input_port name="distance_m">Metres to travel sideways</input_port>
      <input_port name="speed" default="0.2">m/s</input_port>
      <input_port name="heading_deg" default="0">Heading to hold, degrees left of the start heading</input_port>
    </Action>
    <Action ID="StrafeRight">
      <input_port name="distance_m">Metres to travel sideways</input_port>
      <input_port name="speed" default="0.2">m/s</input_port>
      <input_port name="heading_deg" default="0">Heading to hold, degrees left of the start heading</input_port>
    </Action>
    <Action ID="Turn">
      <input_port name="heading_deg">Heading to face, degrees left of the start heading</input_port>
      <input_port name="tolerance_deg" default="4">Close enough, in degrees</input_port>
    </Action>
    <Action ID="Hold">
      <input_port name="seconds" default="2">How long to hold position</input_port>
      <input_port name="heading_deg" default="0">Heading to hold, degrees left of the start heading</input_port>
    </Action>
    <Action ID="Surface">
      <input_port name="seconds" default="10">How long to rise</input_port>
      <input_port name="speed" default="0.2">Upward speed, m/s</input_port>
    </Action>
  </TreeNodesModel>
</root>
