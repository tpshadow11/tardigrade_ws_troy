<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      BTCPP_version="4.10"
      main_tree_to_execute="DiveTest">
  <BehaviorTree ID="DiveTest">
    <Fallback name="Mission, else surface">
      <Sequence name="Mission">
        <WaitForOdometry timeout_sec="30"/>
        <RecordStart/>
        <ReactiveSequence name="Safety">
          <OdometryFresh max_age_sec="0.5"/>
          <IsArmed/>
          <Sequence name="Moves">
            <Timeout msec="60000">
              <GoToDepth name="Dive 0.5 m"
                         depth_m="0.5"/>
            </Timeout>
            <Hold seconds="5"/>
            <Timeout msec="60000">
              <GoToDepth name="Back to start depth"
                         depth_m="0.0"/>
            </Timeout>
          </Sequence>
        </ReactiveSequence>
      </Sequence>
      <Sequence name="Surface, then report failure">
        <Surface seconds="10"/>
        <AlwaysFailure/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="MyFirst">
    <Fallback name="Mission, else surface">
      <Sequence name="Mission">
        <WaitForOdometry timeout_sec="30"/>
        <RecordStart/>
        <ReactiveSequence name="Safety">
          <OdometryFresh max_age_sec="0.5"/>
          <IsArmed/>
          <Sequence name="Moves">
            <Timeout msec="60000">
              <GoToDepth name="Dive 0.5 m"
                         depth_m="0.5"/>
            </Timeout>
            <Hold seconds="5"/>
            <Timeout msec="60000">
              <GoToDepth name="Back to start depth"
                         depth_m="0.0"/>
            </Timeout>
          </Sequence>
        </ReactiveSequence>
      </Sequence>
      <Sequence name="Surface, then report failure">
        <Surface seconds="10"/>
        <AlwaysFailure/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="GoToDepth">
      <input_port name="depth_m">Metres below the start depth</input_port>
      <input_port name="tolerance_m"
                  default="0.05">Close enough, in metres</input_port>
      <input_port name="max_speed"
                  default="0.2">Vertical speed limit, m/s</input_port>
      <input_port name="heading_deg"
                  default="0">Heading to hold, degrees left of the start heading</input_port>
    </Action>
    <Action ID="Hold">
      <input_port name="seconds"
                  default="2">How long to hold position</input_port>
      <input_port name="heading_deg"
                  default="0">Heading to hold, degrees left of the start heading</input_port>
    </Action>
    <Condition ID="IsArmed"/>
    <Condition ID="OdometryFresh">
      <input_port name="max_age_sec"
                  default="0.5">Odometry older than this counts as stale</input_port>
    </Condition>
    <Action ID="RecordStart"/>
    <Action ID="Surface">
      <input_port name="seconds"
                  default="10">How long to rise</input_port>
      <input_port name="speed"
                  default="0.2">Upward speed, m/s</input_port>
    </Action>
    <Action ID="WaitForOdometry">
      <input_port name="timeout_sec"
                  default="30">Fail if no odometry arrives within this many seconds</input_port>
      <input_port name="max_age_sec"
                  default="0.5">Odometry older than this counts as missing</input_port>
    </Action>
  </TreeNodesModel>

</root>
